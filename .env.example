# Public server API origin only. Leave empty for the honest local-guest preview.
# All identity-provider credentials, payment secrets and webhook signing keys belong on the server.
VITE_MEMBERSHIP_API_URL=

# Optional PUBLIC catalogue JSON endpoint (HTTPS or same-origin /path).
# Must implement the v1 snapshot and this preview's editorial compatibility policy.
# No key/token in this URL. Empty uses the existing bundled catalogue immediately.
VITE_CATALOGUE_API_URL=
